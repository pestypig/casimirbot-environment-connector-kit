{
  "name": "@casimirbot/environment-connector-kit",
  "version": "0.1.0-mit-candidate.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/connectors/environment/contract/v1/index.d.ts",
      "import": "./dist/connectors/environment/contract/v1/index.js"
    },
    "./sdk": {
      "types": "./dist/connectors/environment/sdk/typescript/index.d.ts",
      "import": "./dist/connectors/environment/sdk/typescript/index.js"
    },
    "./examples/system-clock": {
      "types": "./dist/connectors/environment/examples/system-clock/connector.d.ts",
      "import": "./dist/connectors/environment/examples/system-clock/connector.js"
    },
    "./examples/synthetic": {
      "types": "./dist/connectors/environment/examples/synthetic/connector.d.ts",
      "import": "./dist/connectors/environment/examples/synthetic/connector.js"
    },
    "./templates/read-only": {
      "types": "./dist/connectors/environment/templates/read-only/connector.d.ts",
      "import": "./dist/connectors/environment/templates/read-only/connector.js"
    },
    "./testing/mock": {
      "types": "./dist/connectors/environment/conformance/mock-helix.d.ts",
      "import": "./dist/connectors/environment/conformance/mock-helix.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.20.5"
  },
  "files": [
    "dist",
    "src",
    "java",
    "tsconfig.build.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt",
    "provenance.json"
  ]
}
